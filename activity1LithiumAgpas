class Hero:
    def __init__(self, name, hp):
        self.name = name
        self.hp = hp

    def __repr__(self):
        return f"I'm {self.name} with {self.hp} HP"

    def take_damage(self, amount):
        self.hp -= amount
        if self.hp < 0:
            self.hp = 0


arthur = Hero("Arthur", 100)
morgana = Hero("Morgana", 100)

arthur.take_damage(10)

print(f"Arthur's HP after taking damage: {arthur.hp}")
print(f"Morgana's HP: {morgana.hp}")

print(arthur)
print(morgana)
